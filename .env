# API Configuration - Backend Laravel URL
# Since your React frontend (Vite) runs on localhost:5174
# and your Laravel backend likely runs on a different port or domain,
# you need to specify the backend URL here

# If your Laravel backend is on port 8000:
VITE_API_BASE=http://127.0.0.1:8001

# Or if it's on port 8001:
# VITE_API_BASE=http://127.0.0.1:8001

# Or if it's on your admin domain:
# VITE_API_BASE=https://admin.finreach.com.au
